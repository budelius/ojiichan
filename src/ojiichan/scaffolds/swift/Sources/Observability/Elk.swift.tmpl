// ojiichan: scaffolded ELK structured event logging (backend=__OJIICHAN_BACKEND__)
//
// Posts one structured document per event, matching the index naming and
// document shape produced by ojiichan's Python `ElkClient.log_event`
// (`<index_prefix>-<topic>` / `_doc`). The sink is chosen by `ELK_TRANSPORT`
// (`es` | `logstash` | `otlp`) — see `elkWriteTarget`. Falls back to console
// logging when the transport is unconfigured or the request fails, so the
// diagnostics path never throws.
//
// Uses `URLSession` from Foundation; no Elasticsearch client dependency.

import Foundation

public struct LogEventOptions {
    public var level: String
    public var topic: String?
    public var subtype: String?
    public var failure: Bool?
    // Keys removed from the payload before indexing — keep secrets out of ELK.
    public var redactKeys: [String]

    public init(
        level: String = "info",
        topic: String? = nil,
        subtype: String? = nil,
        failure: Bool? = nil,
        redactKeys: [String] = []
    ) {
        self.level = level
        self.topic = topic
        self.subtype = subtype
        self.failure = failure
        self.redactKeys = redactKeys
    }
}

private func serviceName() -> String {
    env("SERVICE_NAME") ?? env("APP_NAME") ?? "app"
}

@discardableResult
public func logEvent(
    _ eventType: String,
    data: [String: Any] = [:],
    options: LogEventOptions = LogEventOptions()
) async -> Bool {
    let cfg = elkConfig()

    var payload = data
    for key in options.redactKeys { payload.removeValue(forKey: key) }

    var document = payload
    document["@timestamp"] = ISO8601DateFormatter().string(from: Date())
    document["event_type"] = eventType
    document["operation"] = (payload["operation"] as? String) ?? eventType
    document["level"] = options.level
    document["service"] = serviceName()
    if let subtype = options.subtype { document["subtype"] = subtype }
    if let failure = options.failure { document["failure"] = failure }

    let index = "\(cfg.indexPrefix)-\(options.topic ?? eventType)"

    func logLocally(_ suffix: String = "") {
        FileHandle.standardError.write(
            Data("[ELK:\(index)] \(document)\(suffix)\n".utf8)
        )
    }

    guard elkWriteTarget(cfg) != nil else {
        logLocally()
        return false
    }

    switch cfg.transport {
    case .logstash:
        return await sendLogstash(cfg, index: index, document: document, logLocally: logLocally)
    case .otlp:
        return await sendOtlp(cfg, document: document, level: options.level, logLocally: logLocally)
    case .es:
        return await sendElasticsearch(cfg, index: index, document: document, logLocally: logLocally)
    }
}

private func basicAuthValue(_ cfg: ElkConfig) -> String? {
    guard let user = cfg.username, let password = cfg.password else { return nil }
    return "Basic \(Data("\(user):\(password)".utf8).base64EncodedString())"
}

private func sendJSON(
    _ url: URL,
    body: Data,
    cfg: ElkConfig,
    headers: [String: String],
    logLocally: (String) -> Void
) async -> Bool {
    var request = URLRequest(url: url, timeoutInterval: cfg.timeout)
    request.httpMethod = "POST"
    request.setValue("application/json", forHTTPHeaderField: "Content-Type")
    for (key, value) in headers { request.setValue(value, forHTTPHeaderField: key) }
    request.httpBody = body
    do {
        let (_, response) = try await URLSession.shared.data(for: request)
        let status = (response as? HTTPURLResponse)?.statusCode ?? 0
        return (200..<300).contains(status)
    } catch {
        logLocally(" send failed: \(error)")
        return false
    }
}

private func sendElasticsearch(
    _ cfg: ElkConfig,
    index: String,
    document: [String: Any],
    logLocally: (String) -> Void
) async -> Bool {
    guard let base = elkBaseURL(cfg) else { logLocally(""); return false }
    guard
        let url = URL(string: "\(base)/\(index)/_doc"),
        let body = try? JSONSerialization.data(withJSONObject: document)
    else {
        logLocally(" (failed to encode document)")
        return false
    }
    var headers: [String: String] = [:]
    if let auth = basicAuthValue(cfg) { headers["Authorization"] = auth }
    return await sendJSON(url, body: body, cfg: cfg, headers: headers, logLocally: logLocally)
}

// POST the document to a Logstash HTTP input. The index travels as an `index`
// field so a Logstash pipeline can route to the same `<prefix>-<topic>` index
// the `es` transport writes to directly.
private func sendLogstash(
    _ cfg: ElkConfig,
    index: String,
    document: [String: Any],
    logLocally: (String) -> Void
) async -> Bool {
    guard let urlString = cfg.logstashURL, let url = URL(string: urlString) else {
        logLocally("")
        return false
    }
    var payload = document
    payload["index"] = index
    guard let body = try? JSONSerialization.data(withJSONObject: payload) else {
        logLocally(" (failed to encode document)")
        return false
    }
    var headers: [String: String] = [:]
    if let auth = basicAuthValue(cfg) { headers["Authorization"] = auth }
    return await sendJSON(url, body: body, cfg: cfg, headers: headers, logLocally: logLocally)
}

// Map a textual level to an OTLP SeverityNumber.
// https://opentelemetry.io/docs/specs/otel/logs/data-model/#severity-fields
private func otlpSeverityNumber(_ level: String) -> Int {
    switch level.lowercased() {
    case "trace": return 1
    case "debug": return 5
    case "warn", "warning": return 13
    case "error": return 17
    case "fatal", "critical": return 21
    default: return 9
    }
}

// Wrap a value as an OTLP AnyValue. `Bool` is matched first: a boolean bridged
// from JSON is an NSNumber and would otherwise serialize as `intValue: "1"`.
//
// An array of scalars becomes a real `arrayValue` so backends can index the
// elements. Dictionaries and nested arrays stay a compact JSON `stringValue`: a
// `kvlistValue` arrives at OpenSearch as an object, and a field already mapped
// as text rejects the document with a mapping conflict. The string form is
// lossless and safe to change later; the mapping is not.
private func otlpAnyValue(_ value: Any) -> [String: Any] {
    switch value {
    case let b as Bool: return ["boolValue": b]
    case let i as Int: return ["intValue": String(i)]
    case let d as Double: return ["doubleValue": d]
    case let s as String: return ["stringValue": s]
    case let array as [Any] where array.allSatisfy(isOtlpScalar):
        return ["arrayValue": ["values": array.map(otlpAnyValue)]]
    default:
        if JSONSerialization.isValidJSONObject(value),
            let data = try? JSONSerialization.data(withJSONObject: value),
            let json = String(data: data, encoding: .utf8) {
            return ["stringValue": json]
        }
        return ["stringValue": "\(value)"]
    }
}

private func isOtlpScalar(_ value: Any) -> Bool {
    value is Bool || value is Int || value is Double || value is String
}

// Parse the standard `OTEL_EXPORTER_OTLP_HEADERS` format: comma-separated
// `key=value` pairs, e.g. `authorization=Bearer xyz,x-tenant=acme`.
private func parseOtlpHeaders(_ raw: String?) -> [String: String] {
    var headers: [String: String] = [:]
    for pair in (raw ?? "").split(separator: ",") {
        let parts = pair.split(separator: "=", maxSplits: 1)
        guard parts.count == 2 else { continue }
        headers[parts[0].trimmingCharacters(in: .whitespaces)] =
            parts[1].trimmingCharacters(in: .whitespaces)
    }
    return headers
}

// Ship the event as an OTLP/HTTP JSON LogRecord to `<endpoint>/v1/logs`.
private func sendOtlp(
    _ cfg: ElkConfig,
    document: [String: Any],
    level: String,
    logLocally: (String) -> Void
) async -> Bool {
    guard let endpoint = cfg.otlpEndpoint else { logLocally(""); return false }
    let urlString = endpoint.hasSuffix("/v1/logs") ? endpoint : "\(endpoint)/v1/logs"
    guard let url = URL(string: urlString) else { logLocally(""); return false }

    var timeUnixNano = "0"
    if let ts = document["@timestamp"] as? String,
        let date = ISO8601DateFormatter().date(from: ts) {
        timeUnixNano = String(Int(date.timeIntervalSince1970 * 1_000_000_000))
    }
    let attributes: [[String: Any]] = document
        .filter { $0.key != "@timestamp" }
        .map { ["key": $0.key, "value": otlpAnyValue($0.value)] }
    let bodyText = (document["message"] as? String) ?? (document["event_type"] as? String) ?? ""
    let payload: [String: Any] = [
        "resourceLogs": [[
            "resource": [
                "attributes": [[
                    "key": "service.name",
                    "value": ["stringValue": (document["service"] as? String) ?? "app"],
                ]]
            ],
            "scopeLogs": [[
                "scope": ["name": "ojiichan"],
                "logRecords": [[
                    "timeUnixNano": timeUnixNano,
                    "severityNumber": otlpSeverityNumber(level),
                    "severityText": level.uppercased(),
                    "body": ["stringValue": bodyText],
                    "attributes": attributes,
                ]],
            ]],
        ]]
    ]
    guard let body = try? JSONSerialization.data(withJSONObject: payload) else {
        logLocally(" (failed to encode OTLP payload)")
        return false
    }
    // Obachan's Data Prepper `otel_logs_source` behind ingest.<apex>
    // authenticates the shared `ojiichan` ingest identity with HTTP basic auth —
    // the same credential `sendLogstash` already sends. Without this, switching
    // ELK_TRANSPORT from `logstash` to `otlp` turns every event into a 401, and
    // `logEvent` only reports failures, so the outage is silent.
    //
    // An explicit `authorization` header in OTEL_EXPORTER_OTLP_HEADERS wins: a
    // collector using bearer tokens must not have it overwritten.
    var headers = parseOtlpHeaders(cfg.otlpHeaders)
    let hasExplicitAuth = headers.keys.contains { $0.lowercased() == "authorization" }
    if !hasExplicitAuth, let auth = basicAuthValue(cfg) { headers["Authorization"] = auth }
    return await sendJSON(url, body: body, cfg: cfg, headers: headers, logLocally: logLocally)
}
