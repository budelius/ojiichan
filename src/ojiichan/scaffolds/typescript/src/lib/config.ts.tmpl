// ojiichan: scaffolded observability config (backend=__OJIICHAN_BACKEND__)
//
// Mirrors ojiichan's Python `config.py`: every value is resolved from the
// environment, preferring an `OJIICHAN_`-prefixed override, then the
// conventional variable name. This keeps a TypeScript service wired to the same
// ELK + Rustrak/Sentry stack as the Python services without a shared library.

export function env(name: string, fallback?: string): string | undefined {
  return process.env[`OJIICHAN_${name}`] ?? process.env[name] ?? fallback;
}

export function envBool(name: string, fallback = false): boolean {
  const value = env(name);
  if (value === undefined) return fallback;
  return ["1", "true", "yes", "on"].includes(value.toLowerCase());
}

export interface SentryConfig {
  dsn?: string;
  environment?: string;
  release?: string;
  service?: string;
  tracesSampleRate: number;
}

export function sentryConfig(): SentryConfig {
  return {
    dsn: env("SENTRY_DSN"),
    environment: env("ENVIRONMENT") ?? env("APP_ENV") ?? env("ENV"),
    release: env("RELEASE") ?? env("GIT_COMMIT"),
    service: env("SERVICE_NAME") ?? env("APP_NAME"),
    tracesSampleRate: Number(env("SENTRY_TRACES_SAMPLE_RATE", "0")),
  };
}

// Write transport for structured events. `es` indexes straight into
// Elasticsearch; `logstash` POSTs the document to a Logstash HTTP input; `otlp`
// ships an OpenTelemetry LogRecord to an OTLP/HTTP endpoint (usually a
// Collector) that routes to ELK. The document shape is identical across
// transports, so events stay queryable together.
export type ElkTransport = "es" | "otlp" | "logstash";
const ELK_TRANSPORTS: ElkTransport[] = ["es", "otlp", "logstash"];

export interface ElkConfig {
  host?: string;
  port: number;
  username?: string;
  password?: string;
  useSsl: boolean;
  verifyCerts: boolean;
  indexPrefix: string;
  timeoutMs: number;
  transport: ElkTransport;
  logstashUrl?: string;
  otlpEndpoint?: string;
  otlpHeaders?: string;
}

export function elkConfig(): ElkConfig {
  const requested = (env("ELK_TRANSPORT", "es") ?? "es").toLowerCase();
  const transport = (ELK_TRANSPORTS as string[]).includes(requested)
    ? (requested as ElkTransport)
    : "es";
  return {
    host: env("ELASTICSEARCH_HOST"),
    port: Number(env("ELASTICSEARCH_PORT", "443")),
    username: env("ELASTICSEARCH_USERNAME"),
    password: env("ELASTICSEARCH_PASSWORD"),
    useSsl: envBool("ELASTICSEARCH_USE_SSL", true),
    verifyCerts: envBool("ELASTICSEARCH_VERIFY_CERTS", true),
    indexPrefix: env("ELASTICSEARCH_INDEX_PREFIX", "app") ?? "app",
    timeoutMs: Number(env("ELASTICSEARCH_TIMEOUT", "10")) * 1000,
    transport,
    logstashUrl: env("LOGSTASH_URL")?.replace(/\/+$/, ""),
    // Standard OpenTelemetry env vars (the `OJIICHAN_`-prefixed override still wins).
    otlpEndpoint: env("OTEL_EXPORTER_OTLP_ENDPOINT")?.replace(/\/+$/, ""),
    otlpHeaders: env("OTEL_EXPORTER_OTLP_HEADERS"),
  };
}

// Build the Elasticsearch base URL, honoring a host that already carries a
// scheme (mirrors `ElkConfig.url` in the Python toolkit).
export function elkBaseUrl(cfg: ElkConfig = elkConfig()): string | undefined {
  if (!cfg.host) return undefined;
  if (cfg.host.startsWith("http://") || cfg.host.startsWith("https://")) {
    return cfg.host;
  }
  const scheme = cfg.useSsl ? "https" : "http";
  return `${scheme}://${cfg.host}:${cfg.port}`;
}

// Resolve the sink URL for the active write transport; `undefined` means the
// transport is unconfigured, so callers fall back to console logging.
export function elkWriteTarget(cfg: ElkConfig = elkConfig()): string | undefined {
  if (cfg.transport === "logstash") return cfg.logstashUrl;
  if (cfg.transport === "otlp") return cfg.otlpEndpoint;
  return elkBaseUrl(cfg);
}
